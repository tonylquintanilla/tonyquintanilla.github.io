#!/usr/bin/env python3
"""
gallery_maintenance_run.py - one pass over the gallery's generators
and checkers.

THE OTHER RUNNER
The orrery repo has its own, orrery_maintenance_run.py (L-188), and
it is a different program: four generators and eleven checkers over
the orrery's files. Both were called maintenance_run.py until
2026-08-29, when that cost the orrery's copy three commits of not
existing -- this one was downloaded, that one was displaced, and the
dashboard button reported a file that was not there. Renamed under
L-264.

Role: devtool
Domain: dev_tools

The orrery has a runner and the gallery, which is the PUBLIC surface, has
had none. Three of the four defects found when the Sun exhibit shipped on
2026-08-29 were on this side, and no orrery check could reach any of them:
GitHub Pages serving no .py file at all, orphan info markers in the shared
renderer, and data/objects_config.json drifting from the orrery's
constants_new.py. (L-236.)

TWO MOMENTS, NOT ONE
====================
The orrery's runner is one thing that happens before a push, and
everything it reads is on disk. The gallery's most valuable check cannot
work that way. The Jekyll failure was invisible on Tony's machine and
invisible in the repository. It existed only on the live site, and only
after a push.

    python gallery_maintenance_run.py           before you commit
    python gallery_maintenance_run.py --live    after you push

The default pass is offline and deterministic. The --live pass adds the
two checks that can only mean something once GitHub Pages has deployed,
and it does NOT re-run the offline ones.

THREE STATES, NOT TWO
=====================
PASS, FAIL, and UNREACHABLE. A check that could not run is never folded
into "N of N passed", because a check that did not run looks exactly like
a check that passed -- which is the whole of A Check That Cannot Fail Is
Not Passing. Node missing is UNREACHABLE. No network is UNREACHABLE. A
site serving different bytes than your working copy is UNREACHABLE, not
a pass, because the thing you meant to check is not the thing that
answered.

REPORT-ONLY ROWS
================
Two rows never gate, whatever they exit with, and both are deliberate.
Their content is the verdict, not their exit code, and the summary
quotes them in the passing and the failing branch alike so a red
report-only row cannot hide behind a green run. Anything added later
gates by default, which is the safe direction.

    Artifact 1 assembler   its T5 check reads fp.compare(golden, golden)
                           -- the fingerprint against itself, not against
                           the stored file. It passes whatever the golden
                           says. Not load-bearing until L-237 lands.
    Store drift            a report, not a gate. It moves nothing and
                           fixes nothing; it converts a silent hole into
                           a loud one. It is NOT the cross-repo transport
                           (master plan segment 2) and does not replace
                           it.

THE SERVED COPY CARRIES WHAT THE STORE CARRIES
==============================================
How many significant figures a value should have is settled ONCE, in the
orrery, under provenance-discipline: Report to the Figures You Have, and
The Store Carries the Verified Figure. This check does not re-open that
question and does not hand it to a reader. It asks one thing -- does the
copy still say what the store says -- and the answer is exact. A rounded
tail in data/objects_config.json is a finding, not a rounding, because a
copy at a different precision is a second store of the number.

The significant-figure depth printed beside a drift is triage, not a
verdict. Two values agreeing to one figure means information from a
source went missing; agreeing to nine means somebody truncated a float
tail. Both are drift and both are reported. The number just says which
kind you are looking at before you open the file.

Units are converted using KM_PER_AU and SOLAR_RADIUS_AU READ FROM THE
STORE. No conversion factor is typed into this file, because a factor
typed here would be exactly the shadow constant this check exists to
find.

Run it with VS Code's Run button from the gallery repo root. There is
deliberately no dashboard entry: the dashboard lives in the orrery, and
a button there would reach across into a sibling directory, which is the
same cross-repo reach that put this runner in the gallery in the first
place.

Module created: August 2026 with Anthropic's Claude Opus 5 (L-236).
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

# ============================================================
# CONFIGURATION
# ============================================================

PROBE = os.path.join("data", "objects_config.json")

SITE = "https://palomasorrery.com/"
ORRERY_REPO = "tonylquintanilla/palomas_orrery"
ORRERY_BRANCH = "main"

TOOL_TIMEOUT_SECONDS = 900
HTTP_TIMEOUT_SECONDS = 30

NOTE_INDENT = 36
NOTE_WIDTH = 34

# ---- generators: rewrite a file, safe to run every time -------------
# (label, argv-tail, cwd relative to root, output files to fingerprint)
GENERATORS = [
    ("Module atlas", ["module_atlas.py"], ".",
     ["MODULE_ATLAS.md", "MODULE_INDEX.md"]),
]

# ---- offline checkers ------------------------------------------------
# (label, runner, argv-tail, cwd, verdict hint, report_only)
#
# runner is "python" or "node". A node row whose interpreter is missing
# reports UNREACHABLE; it is never skipped and never counted as a pass.
OFFLINE_CHECKERS = [
    ("Cache builder suite", "python",
     ["test_gallery_cache_builder_offline.py"], "tools", None, False),

    ("Feature renderers", "node",
     ["documentation/smoke_features.js", "gallery/feature_renderers.js"],
     ".", None, False),

    # L-262: the framing helpers live in the TEST page, not the live one --
    # interactive.html has neither slice marker. The second file supplies
    # window.GalleryFeatures at process.argv[3]; without it the script
    # throws once the page fix lets it get that far.
    ("Page framing", "node",
     ["documentation/smoke_framing.js",
      "gallery/solar_system_earth_test2.html",
      "gallery/feature_renderers.js"],
     ".", None, False),

    ("Sun shells", "node",
     ["documentation/smoke_sun_shells.js", "gallery/feature_renderers.js",
      "data/objects_config.json"],
     ".", None, False),

    ("Artifact 1 assembler", "python",
     ["-m", "assembler.tests.test_artifact1_earth"], "gallery", "===", True),
]

# ---- live: what the site must actually serve -------------------------
# The underscore-prefixed module is in this list deliberately. It is the
# first name Jekyll drops, and every previous test ran over
# `python -m http.server`, which serves it happily.
SERVED_FILES = [
    "interactive.html",
    "gallery/feature_renderers.js",
    "gallery/assembler/resolver.py",
    "gallery/assembler/__init__.py",
    "data/solar-system/coverage_index.json",
    "data/solar-system/feature_configs.json",
    "data/solar-system/positions/voyager_1.json",
]

# A served .py or .json that comes back as an HTML page is a 404 wearing
# a 200, which is what a Jekyll-shaped failure looks like from outside.
HTML_TELLS = (b"<!DOCTYPE html", b"<!doctype html", b"<html")


# ============================================================
# SMALL HELPERS
# ============================================================

def find_repo_root():
    here = os.path.dirname(os.path.abspath(__file__))
    for label, folder in (("beside this script", here),
                          ("working directory", os.getcwd())):
        if os.path.isfile(os.path.join(folder, PROBE)):
            return folder, label
    return None, None


def wrapped(text, width=NOTE_WIDTH):
    words = " ".join((text or "").split()).split(" ")
    lines, current = [], ""
    for word in words:
        candidate = (current + " " + word).strip()
        if len(candidate) > width and current:
            lines.append(current)
            current = word
        else:
            current = candidate
    if current:
        lines.append(current)
    return lines or [""]


def print_row(state, label, seconds, note):
    lines = wrapped(note)
    print("  %-4s %-22s %6.1fs  %s"
          % (state, label, seconds, lines[0]))
    for extra in lines[1:]:
        print(" " * NOTE_INDENT + extra)


def last_meaningful_line(text):
    for line in reversed((text or "").splitlines()):
        if line.strip():
            return line.strip()
    return "(no output)"


def line_containing(text, hint):
    for line in (text or "").splitlines():
        if hint in line:
            return line.strip()
    return last_meaningful_line(text)


def snapshot(path):
    if not os.path.isfile(path):
        return None
    with open(path, "rb") as handle:
        return hashlib.md5(handle.read()).hexdigest()


# ============================================================
# RUNNING A TOOL
# ============================================================

def run_tool(root, runner, argv_tail, cwd):
    """Return (state, seconds, output). state is PASS / FAIL / N-A."""
    if runner == "node":
        interpreter = shutil.which("node") or shutil.which("nodejs")
        if interpreter is None:
            return ("N-A", 0.0,
                    "node is not installed, so this suite did not run. "
                    "It is not passing and it is not failing.")
        argv = [interpreter] + argv_tail
    else:
        argv = [sys.executable] + argv_tail

    workdir = os.path.join(root, cwd)
    if not os.path.isdir(workdir):
        return ("N-A", 0.0, "no such directory: %s" % cwd)

    started = time.time()
    try:
        completed = subprocess.run(
            argv, cwd=workdir, stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT, timeout=TOOL_TIMEOUT_SECONDS)
    except subprocess.TimeoutExpired:
        return ("FAIL", time.time() - started,
                "timed out after %d seconds" % TOOL_TIMEOUT_SECONDS)
    except OSError as exc:
        return ("N-A", time.time() - started, "could not start: %s" % exc)

    output = completed.stdout.decode("utf-8", "replace")
    state = "PASS" if completed.returncode == 0 else "FAIL"
    return (state, time.time() - started, output)


# ============================================================
# LIVE CHECK 1 -- DOES THE SITE ACTUALLY SERVE IT
# ============================================================

def fetch(url):
    """Return (status, body, error). status is None when unreachable."""
    request = urllib.request.Request(
        url, headers={"User-Agent": "palomas-orrery-maintenance-run"})
    try:
        with urllib.request.urlopen(request,
                                    timeout=HTTP_TIMEOUT_SECONDS) as response:
            return response.getcode(), response.read(), None
    except urllib.error.HTTPError as exc:
        return exc.code, b"", None
    except Exception as exc:                      # network, DNS, TLS, proxy
        return None, b"", str(exc)


def same_content(left, right):
    """True when two files differ only in their line endings.

    .gitattributes normalises this repo to LF on commit, so Pages
    serves LF. Any tool writing in text mode on Windows leaves the
    WORKING COPY as CRLF -- gallery_cache_builder.py writes
    coverage_index.json and feature_configs.json with open(path,
    'w'), which is why exactly those two reported stale on every
    live run while everything else matched.

    The content is identical and the deploy is current. Comparing
    raw bytes called that stale forever, on the one check whose
    whole value is being believed.
    """
    return left.replace(b"\r\n", b"\n") == right.replace(b"\r\n",
                                                            b"\n")


def check_served(root):
    """Fetch each critical-path file from the live site and judge it."""
    print("")
    print("  fetching %d files from %s" % (len(SERVED_FILES), SITE))

    results = []
    unreachable = 0
    for relative in SERVED_FILES:
        status, body, error = fetch(SITE + relative)
        local_path = os.path.join(root, relative.replace("/", os.sep))
        local = None
        if os.path.isfile(local_path):
            with open(local_path, "rb") as handle:
                local = handle.read()

        if status is None:
            verdict, detail = "N-A", error
            unreachable += 1
        elif status == 404:
            verdict, detail = "MISSING", "HTTP 404"
        elif status != 200:
            # A proxy, a captive network or an outage answers every
            # request the same way. That is not the site refusing to
            # serve a file, and calling it one would cry wolf on a
            # check whose whole value is being believed.
            verdict, detail = "N-A", "HTTP %s" % status
            unreachable += 1
        elif (not relative.endswith((".html", ".js"))
              and body[:200].lstrip().startswith(HTML_TELLS)):
            verdict, detail = "MISSING", "200 but served an HTML page"
        elif local is None:
            verdict, detail = "SERVED", "no local copy to compare"
        elif local == body:
            verdict, detail = "SERVED", "matches the working copy"
        elif same_content(local, body):
            # Reported rather than swallowed: the row still says the
            # bytes differ, and says why they are not a difference.
            verdict, detail = "SERVED", ("matches (the working copy "
                                         "is CRLF)")
        else:
            verdict, detail = "STALE", "differs from the working copy"

        results.append((verdict, relative, detail))
        print("    %-8s %-46s %s" % (verdict, relative, detail))

    missing = [row for row in results if row[0] == "MISSING"]
    stale = [row for row in results if row[0] == "STALE"]

    # A 404 on a .py while the .html returns 200 is the Jekyll shape:
    # the site is up and is refusing to serve one family of files. That
    # asymmetry is the signal, which is why a blanket failure above is
    # read as unreachable and a partial one here is read as broken.

    if unreachable == len(results):
        return ("N-A",
                "none of the %d files could be reached; the network, a "
                "proxy or the host is the problem, not the site's "
                "contents." % len(results))
    if missing:
        return ("FAIL",
                "%d of %d files are NOT SERVED: %s. If you pushed in the "
                "last few minutes, wait and re-run before believing it."
                % (len(missing), len(results),
                   ", ".join(row[1] for row in missing)))
    if stale:
        return ("N-A",
                "all %d files served, but %d differ from your working copy, "
                "so this describes an older deploy or you have uncommitted "
                "edits. NOT YET DEPLOYED, not a pass."
                % (len(results), len(stale)))
    return ("PASS", "all %d files served and byte-identical to the working "
                    "copy" % len(results))


# ============================================================
# LIVE CHECK 2 -- STORE DRIFT (REPORT ONLY)
# ============================================================

SAFE_OPS = (
    "Add", "Sub", "Mult", "Div", "Pow", "USub", "UAdd",
)

COEFFICIENT = re.compile(r"^([0-9.]+) \* SOLAR_RADIUS_AU$")
BARE_NUMBER = re.compile(r"^-?[0-9.]+$")

# The store declares a constant's unit in its NAME, which is the one
# thing here that is read by convention rather than stated outright. A
# name carrying no unit suffix is REPORTED, never assumed -- so the
# convention can only cost coverage, never produce a false match. A
# declared unit beside the value would remove even that, and belongs
# with the status line (L-256, L-240).
UNIT_BY_SUFFIX = (("_RADII", "r_sun"), ("_AU", "au"), ("_KM", "km"))


def parse_constants(source):
    """Top-level numeric assignments, evaluated without executing anything.

    Returns {name: (value, expression_text)}. A name whose expression this
    cannot evaluate is left OUT rather than guessed at -- it then reports
    downstream as something that could not be examined, which is the
    announcement, not a silence.
    """
    import ast

    tree = ast.parse(source)
    values, expressions = {}, {}

    def evaluate(node):
        if isinstance(node, ast.Constant) and isinstance(node.value,
                                                         (int, float)):
            return float(node.value)
        if isinstance(node, ast.Name):
            return values.get(node.id)
        if isinstance(node, ast.UnaryOp):
            if type(node.op).__name__ not in SAFE_OPS:
                return None
            inner = evaluate(node.operand)
            if inner is None:
                return None
            return -inner if isinstance(node.op, ast.USub) else inner
        if isinstance(node, ast.BinOp):
            if type(node.op).__name__ not in SAFE_OPS:
                return None
            left, right = evaluate(node.left), evaluate(node.right)
            if left is None or right is None:
                return None
            try:
                if isinstance(node.op, ast.Add):
                    return left + right
                if isinstance(node.op, ast.Sub):
                    return left - right
                if isinstance(node.op, ast.Mult):
                    return left * right
                if isinstance(node.op, ast.Div):
                    return left / right
                if isinstance(node.op, ast.Pow):
                    return left ** right
            except (ZeroDivisionError, OverflowError, ValueError):
                return None
        return None

    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        if len(node.targets) != 1 or not isinstance(node.targets[0], ast.Name):
            continue
        value = evaluate(node.value)
        if value is None:
            continue
        name = node.targets[0].id
        values[name] = value
        segment = ast.get_source_segment(source, node.value) or ""
        expressions[name] = " ".join(segment.split())

    return dict((name, (values[name], expressions[name])) for name in values)


def collect_pointers(config):
    """Every dict in objects_config.json carrying an orrery_constant."""
    found = []

    def walk(node, path):
        if isinstance(node, dict):
            if "orrery_constant" in node:
                found.append((path, node))
            for key, value in node.items():
                walk(value, path + "/" + key)
        elif isinstance(node, list):
            for index, value in enumerate(node):
                walk(value, path + "/%d" % index)

    walk(config, "")
    return found


def config_value(entry):
    """The number this pointer sits beside, and its unit."""
    if "value" in entry:
        return entry["value"], str(entry.get("unit") or "").lower()
    for value in entry.values():
        if isinstance(value, dict) and "value" in value:
            return value["value"], str(value.get("unit") or "").lower()
    return None, ""


def store_conversions(constants):
    """Unit factors, taken FROM THE STORE rather than typed in here.

    KM_PER_AU is the IAU definition and SOLAR_RADIUS_AU is the AU-to-solar-
    radii factor the orrery already derives. Typing either number into
    this file would make it a shadow constant, which is the failure this
    check exists to find. If the store stops carrying them, the check
    says so and does not fall back on a remembered value.
    """
    if "KM_PER_AU" not in constants or "SOLAR_RADIUS_AU" not in constants:
        return None
    km_per_au = constants["KM_PER_AU"][0]
    solar_radius_au = constants["SOLAR_RADIUS_AU"][0]
    if not km_per_au or not solar_radius_au:
        return None
    return {"au": 1.0, "km": 1.0 / km_per_au, "r_sun": solar_radius_au}


def agreement_depth(left, right):
    """How many significant figures two numbers share. Triage, not verdict."""
    if left == right:
        return None
    for digits in range(15, 0, -1):
        if float("%.*g" % (digits, left)) == float("%.*g" % (digits, right)):
            return digits
    return 0


def judge(name, expression, orrery_value, value, unit, to_au):
    """MATCH or a finding, for one pointer.

    The served copy must carry WHAT THE STORE CARRIES. How many figures a
    value should have is settled in the orrery under provenance-discipline
    and is not re-litigated here; this check only asks whether the copy
    still says the same thing. So the comparison is EXACT when both sides
    are already in the same unit, and any difference at all -- including a
    rounded tail -- is a finding rather than a judgement call handed back
    to a reader.
    """
    if value is None:
        return "NO VALUE", "pointer sits beside no value"

    # Fast path, and the exact one: a coefficient times the solar radius
    # compared against a config value already in solar radii is a
    # comparison of two literals with no arithmetic in between.
    match = COEFFICIENT.match(expression)
    if match and unit == "r_sun":
        coefficient = float(match.group(1))
        if coefficient == value:
            return "MATCH", ""
        return "DRIFT", ("orrery %.12g, config %.12g -- %s"
                         % (coefficient, value,
                            _depth_note(coefficient, value)))

    orrery_unit = None
    for suffix, unit_name in UNIT_BY_SUFFIX:
        if name.endswith(suffix):
            orrery_unit = unit_name
            break
    if orrery_unit is None:
        return "NO UNIT", "the constant's name declares no unit"
    if unit not in to_au:
        return "NO UNIT", "config unit %r has no factor in the store" % unit

    if orrery_unit == unit:
        if orrery_value == value:
            return "MATCH", ""
        return "DRIFT", ("orrery %.12g, config %.12g -- %s"
                         % (orrery_value, value,
                            _depth_note(orrery_value, value)))

    # Units differ, so a conversion stands between the two numbers and
    # exact equality would fail on float arithmetic alone. The tolerance
    # is the width of that arithmetic and nothing more: it is far tighter
    # than any rounding a person would do by hand.
    converted = orrery_value * to_au[orrery_unit] / to_au[unit]
    if abs(converted - value) <= abs(value) * 1e-12:
        return "MATCH", ""
    return "DRIFT", ("orrery %.12g %s, config %.12g %s -- %s"
                     % (converted, unit, value, unit,
                        _depth_note(converted, value)))


def _depth_note(left, right):
    depth = agreement_depth(left, right)
    if depth is None:
        return "identical"
    if depth == 0:
        return "they do not agree to one significant figure"
    return ("they agree to %d significant figure%s"
            % (depth, "" if depth == 1 else "s"))


def check_store_drift(root):
    """Follow objects_config.json's pointers into the orrery's store."""
    print("")
    status, body, error = fetch(
        "https://api.github.com/repos/%s/commits/%s"
        % (ORRERY_REPO, ORRERY_BRANCH))
    if status != 200:
        return ("N-A", "could not read the orrery HEAD SHA (%s)"
                % (error or "HTTP %s" % status))
    try:
        sha = json.loads(body.decode("utf-8"))["sha"]
    except (ValueError, KeyError) as exc:
        return ("N-A", "unreadable answer from the commits API: %s" % exc)

    print("  orrery HEAD %s" % sha[:8])

    status, body, error = fetch(
        "https://raw.githubusercontent.com/%s/%s/constants_new.py"
        % (ORRERY_REPO, sha))
    if status != 200:
        return ("N-A", "could not fetch constants_new.py at %s (%s)"
                % (sha[:8], error or "HTTP %s" % status))

    try:
        constants = parse_constants(body.decode("utf-8"))
    except SyntaxError as exc:
        return ("N-A", "constants_new.py did not parse: %s" % exc)

    to_au = store_conversions(constants)
    if to_au is None:
        return ("N-A", "the store no longer carries KM_PER_AU and "
                       "SOLAR_RADIUS_AU, so nothing here can convert "
                       "units without typing a factor in. It will not.")

    with open(os.path.join(root, PROBE), "rb") as handle:
        config = json.loads(handle.read().decode("utf-8"))

    pointers = collect_pointers(config)
    tally = {"MATCH": 0, "DRIFT": 0, "NO UNIT": 0, "NO VALUE": 0,
             "NOT IN STORE": 0}
    notable = []

    for path, entry in pointers:
        name = entry["orrery_constant"].split("::")[-1]
        value, unit = config_value(entry)
        if name not in constants:
            tally["NOT IN STORE"] += 1
            notable.append(("NOT IN STORE", name,
                            "not a top-level constant in the store", path))
            continue
        orrery_value, expression = constants[name]
        verdict, detail = judge(name, expression, orrery_value, value, unit,
                                to_au)
        tally[verdict] += 1
        if verdict != "MATCH":
            notable.append((verdict, name, detail, path))

    for verdict, name, detail, path in notable:
        print("    %-13s %-32s %s" % (verdict, name, detail))
        print("                  %s" % path)

    unexamined = tally["NO UNIT"] + tally["NO VALUE"] + tally["NOT IN STORE"]
    print("  %d pointers: %d match, %d DRIFT, %d could not be examined."
          % (len(pointers), tally["MATCH"], tally["DRIFT"], unexamined))

    # Report-only, so this state never gates. It still says FAIL when a
    # value has drifted, because the summary prints report-only rows with
    # their state and a drift should be red on the page even though the
    # run stays green.
    return ("FAIL" if tally["DRIFT"] else "PASS",
            "%d pointers against orrery %s -- %d match, %d DRIFT, %d could "
            "not be examined."
            % (len(pointers), sha[:8], tally["MATCH"], tally["DRIFT"],
               unexamined))


LIVE_CHECKERS = [
    ("Served reachability", check_served, False),
    ("Store drift", check_store_drift, True),
]


# ============================================================
# MAIN
# ============================================================

def run_generators(root, results):
    print("GENERATORS -- rewritten every time; a no-op when nothing moved")
    for label, argv_tail, cwd, outputs in GENERATORS:
        before = dict((name, snapshot(os.path.join(root, name)))
                      for name in outputs)
        state, seconds, output = run_tool(root, "python", argv_tail, cwd)
        after = dict((name, snapshot(os.path.join(root, name)))
                     for name in outputs)
        changed = [name for name in outputs if before[name] != after[name]]
        if state == "PASS":
            note = ("rewrote " + ", ".join(changed)) if changed \
                else "no change to " + ", ".join(outputs)
        else:
            note = last_meaningful_line(output)
        print_row(state, label, seconds, note)
        results.append((state, label, seconds, note, output, False,
                        False))
    print("")


def run_checkers(root, checkers, results):
    print("CHECKERS -- the verdict informs the push call")
    for label, runner, argv_tail, cwd, hint, report_only in checkers:
        state, seconds, output = run_tool(root, runner, argv_tail, cwd)
        if state == "N-A":
            note = output
        elif hint:
            note = line_containing(output, hint)
        else:
            note = last_meaningful_line(output)
        print_row(state, label, seconds, note)
        results.append((state, label, seconds, note, output, report_only,
                        True))
    print("")


def run_live(root, results):
    print("LIVE -- what the deployed site actually serves")
    for label, function, report_only in LIVE_CHECKERS:
        started = time.time()
        try:
            state, note = function(root)
        except Exception as exc:                  # a checker must not crash
            state, note = "N-A", "the check itself raised: %s" % exc
        seconds = time.time() - started
        print("")
        print_row(state, label, seconds, note)
        results.append((state, label, seconds, note, "", report_only,
                        True))
    print("")


def summarize(results):
    checkers = [row for row in results if row[6]]
    report_only = [row for row in checkers if row[5]]
    gating = [row for row in checkers if not row[5]]
    # A report-only row NEVER gates, whatever it exits with. Two of them
    # exit non-zero today for reasons that are recorded rather than
    # broken, and letting those turn the whole run red is how a reader
    # learns to wave the run off.
    failed = [row for row in gating if row[0] == "FAIL"]
    unreachable = [row for row in checkers if row[0] == "N-A"]
    gating_ran = [row for row in gating if row[0] != "N-A"]

    print("=" * 70)
    if failed:
        print("  %d of %d gating checkers FAILED"
              % (len(failed), len(gating_ran)))
        print("  " + ", ".join(row[1] for row in failed))
    elif not gating_ran:
        print("  NO gating checker was able to run.")
    else:
        passed = [row for row in gating_ran if row[0] == "PASS"]
        print("  %d of %d gating checkers passed"
              % (len(passed), len(gating_ran)))

    # Printed in BOTH branches, and never folded into the count above.
    # A check that did not run is not a check that passed, and hiding
    # that behind a green summary is the failure this block exists to
    # prevent.
    if unreachable:
        print("  %d UNREACHABLE -- did not run, so they neither passed nor "
              "failed:" % len(unreachable))
        for row in unreachable:
            print("    %-22s %s" % (row[1], wrapped(row[3], 40)[0]))

    # Anything already named above is not repeated here. A row that is
    # both report-only and unreachable is one fact, not two.
    report_only = [row for row in report_only if row not in unreachable]
    if report_only:
        print("  %d report-only -- these do not gate, whatever they "
              "exit with:" % len(report_only))
        for row in report_only:
            print("    %-4s %-22s %s"
                  % (row[0], row[1], wrapped(row[3], 40)[0]))
    print("=" * 70)

    for row in results:
        if row[0] != "FAIL" or not row[4]:
            continue
        print("")
        print("-" * 70)
        print("%s -- %s" % (row[1], row[3]))
        print("-" * 70)
        print(row[4].rstrip())

    return 1 if failed else 0


def main():
    live = "--live" in sys.argv[1:]
    unknown = [arg for arg in sys.argv[1:] if arg != "--live"]
    if unknown:
        print("gallery_maintenance_run.py takes one optional flag, "
              "--live.")
        print("Not understood: %s" % ", ".join(unknown))
        return 2

    root, where = find_repo_root()
    if root is None:
        print("REFUSED: could not find %s." % PROBE)
        print("         Run this from the GALLERY repo root")
        print("         (tonyquintanilla.github.io), not the orrery.")
        return 2

    print("=" * 70)
    print("  gallery maintenance run -- %s"
          % ("LIVE (after a push)" if live else "OFFLINE (before a commit)"))
    print("  root: %s   (found %s)" % (root, where))
    print("=" * 70)
    print("")

    results = []
    if live:
        run_live(root, results)
    else:
        run_generators(root, results)
        run_checkers(root, OFFLINE_CHECKERS, results)

    code = summarize(results)

    print("")
    if live:
        print("  Offline pass: python gallery_maintenance_run.py")
    else:
        print("  After you push: python gallery_maintenance_run.py --live")
    return code


if __name__ == "__main__":
    sys.exit(main())
